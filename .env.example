# Docker Compose chạy được khi chưa có .env. Các dòng dưới là tùy chọn.
CP3_PROVIDER=ollama
CP3_MODEL=qwen2.5:1.5b

# OpenAI trực tiếp: đổi CP3_PROVIDER thành openai rồi điền key vào .env.
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=

# Lệnh Python chạy trực tiếp dùng MODEL_PROVIDER thay cho CP3_PROVIDER.
# MODEL_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
